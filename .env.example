# ─────────────────────────────────────────────
#  SOCKS5 прокси (опционально)
#  Формат: socks5://user:password@host:port
#          socks5://host:port  (без авторизации)
#  Если не нужен — оставь пустым или удали строку
#  Используется: requests/LinkedIn, httpx/Google/OpenAI, Telegram Bot API (aiogram).
# ─────────────────────────────────────────────
SOCKS5_PROXY=

# ─────────────────────────────────────────────
#  LinkedIn API
#  Получить на: https://www.linkedin.com/developers/apps
# ─────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Single-user режим (CLI / прямой запуск backend.auth):
# заполняется автоматически после python -m backend.auth
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ─────────────────────────────────────────────
#  Google AI — Gemini 3.1 Flash Lite (текст поста + промпты картинок)
#  Получить на: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────
#  OpenAI — gpt-image-1 (картинки-инфографика с текстом)
#  Получить на: https://platform.openai.com/api-keys
#  Нужен включённый Billing
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# Качество картинки: low (~$0.011) | medium (~$0.04) | high (~$0.17)
# medium — оптимально по цене/качеству для LinkedIn-поста
IMAGE_QUALITY=medium

# Максимум картинок на один пост (1-4). Gemini сам выбирает в этих границах.
MAX_IMAGES_PER_POST=2

# ─────────────────────────────────────────────
#  Telegram bot (многопользовательский режим)
#  Получить у @BotFather: /newbot → token
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─────────────────────────────────────────────
#  Режим работы LinkedIn-интеграции
# ─────────────────────────────────────────────
# true  — DEV-режим: OAuth не вызывается, привязка моментальная с фейк-токеном,
#         публикация в LinkedIn не происходит (только генерация + лог).
# false — PROD: реальный OAuth через PUBLIC_BASE_URL и реальная публикация.
MOCK_LINKEDIN=true

# Только для PROD-режима (MOCK_LINKEDIN=false): публичный URL твоего сервера.
# Например, http://1.2.3.4:8000  или  https://my-bot.example.com
# Этот URL + "/oauth/callback" должен быть в LinkedIn App → Auth → Redirect URLs.
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────
#  Биллинг / сервис
# ─────────────────────────────────────────────
# Цена за одну генерацию (в центах). 100 = $1.00
COST_PER_POST_CENTS=100

# Стартовый баланс новых юзеров (в центах). 300 = $3.00
INITIAL_BALANCE_CENTS=300

# Время ежедневного напоминания (HH:MM, локальное время сервера)
DAILY_NOTIFICATION_TIME=18:00

# ─────────────────────────────────────────────
#  База данных
# ─────────────────────────────────────────────
# В DEV (docker-compose.dev.yml) переопределяется на SQLite автоматически.
# В PROD (docker-compose.prod.yml) переопределяется на Postgres автоматически.
# Эта переменная нужна только если запускаешь без docker compose:
DATABASE_URL=sqlite+aiosqlite:///./backend/data/app.db

# Пароль для Postgres в PROD-режиме (нужен только для docker-compose.prod.yml).
# Сгенерируй сильный, например: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_in_prod
