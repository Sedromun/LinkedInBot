# ─────────────────────────────────────────────
#  SOCKS5 прокси (опционально)
#  Формат: socks5://user:password@host:port
#          socks5://host:port  (без авторизации)
#  Если не нужен — оставь пустым или удали строку
# ─────────────────────────────────────────────
SOCKS5_PROXY=

# ─────────────────────────────────────────────
#  LinkedIn API
#  Получить на: https://www.linkedin.com/developers/apps
# ─────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Получается один раз через: python -m backend.auth
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Твой персональный URN — выдаётся после python -m backend.auth
# Формат: urn:li:person:AbCdEfGhIj
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# ─────────────────────────────────────────────
#  Google AI — Gemini 2.5 Flash (текст) + Imagen 3 (картинки)
#  Один ключ для обоих сервисов
#  Получить на: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

